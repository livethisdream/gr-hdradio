options:
  parameters:
    author: gr-hdradio
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Decodes HD1 and HD2 from an unsigned 8-bit recording at 1,488,375
      S/s (nrsc5 support/sample) to hd1.wav and hd2.wav, saves station files to hd_files/,
      and prints the station and song information.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: hd_rx_file
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: HD Radio from a recording
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '1488375'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 12]
    rotation: 0
    state: enabled
- name: center
  id: blocks_add_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    const: '-127.5'
    maxoutbuf: '0'
    minoutbuf: '0'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [330, 152]
    rotation: 0
    state: enabled
- name: deint
  id: blocks_deinterleave
  parameters:
    affinity: ''
    alias: ''
    blocksize: '1'
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_streams: '2'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [590, 148]
    rotation: 0
    state: enabled
- name: f2c
  id: blocks_float_to_complex
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [720, 148]
    rotation: 0
    state: enabled
- name: files
  id: hdradio_hd_file_sink
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    directory: '''hd_files'''
    maxoutbuf: '0'
    mime_types: '[]'
    minoutbuf: '0'
    overwrite: 'False'
    ports: '[]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1220, 330]
    rotation: 0
    state: enabled
- name: hd
  id: hdradio_hd_receiver
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    mode: '''fm'''
    offset: '0'
    paced: 'False'
    preroll: '0.5'
    programs: '[0, 1]'
    samp_rate: samp_rate
    stereo: 'True'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [880, 120]
    rotation: 0
    state: enabled
- name: infile
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: cu8 recording at 1,488,375 S/s
    short_id: f
    type: str
    value: sample
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [330, 12]
    rotation: 0
    state: enabled
- name: scale
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    const: 1 / 128
    maxoutbuf: '0'
    minoutbuf: '0'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [450, 152]
    rotation: 0
    state: enabled
- name: show
  id: blocks_message_debug
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    en_uvec: 'True'
    log_level: info
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1220, 440]
    rotation: 0
    state: enabled
- name: src
  id: blocks_file_source
  parameters:
    affinity: ''
    alias: ''
    begin_tag: pmt.PMT_NIL
    comment: ''
    file: infile
    length: '0'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    repeat: 'False'
    type: byte
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 140]
    rotation: 0
    state: enabled
- name: u2f
  id: blocks_uchar_to_float
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [210, 156]
    rotation: 0
    state: enabled
- name: wav_hd1
  id: blocks_wavfile_sink
  parameters:
    affinity: ''
    alias: ''
    append: 'False'
    bits_per_sample1: FORMAT_PCM_16
    bits_per_sample2: FORMAT_PCM_16
    bits_per_sample3: FORMAT_VORBIS
    bits_per_sample4: FORMAT_PCM_16
    comment: ''
    file: '''hd1.wav'''
    format: FORMAT_WAV
    nchan: '2'
    samp_rate: '44100'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1220, 80]
    rotation: 0
    state: enabled
- name: wav_hd2
  id: blocks_wavfile_sink
  parameters:
    affinity: ''
    alias: ''
    append: 'False'
    bits_per_sample1: FORMAT_PCM_16
    bits_per_sample2: FORMAT_PCM_16
    bits_per_sample3: FORMAT_VORBIS
    bits_per_sample4: FORMAT_PCM_16
    comment: ''
    file: '''hd2.wav'''
    format: FORMAT_WAV
    nchan: '2'
    samp_rate: '44100'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1220, 200]
    rotation: 0
    state: enabled

connections:
- [center, '0', scale, '0']
- [deint, '0', f2c, '0']
- [deint, '1', f2c, '1']
- [f2c, '0', hd, '0']
- [hd, '0', wav_hd1, '0']
- [hd, '1', wav_hd1, '1']
- [hd, '2', wav_hd2, '0']
- [hd, '3', wav_hd2, '1']
- [hd, files, files, files]
- [hd, id3, show, print]
- [hd, station, show, print]
- [scale, '0', deint, '0']
- [src, '0', u2f, '0']
- [u2f, '0', center, '0']

metadata:
  file_format: 1
  grc_version: 3.10.9.2
